# ---------------------------------------------------------------------------
# Configuration of the CQRS / Event Sourcing ledger.
# SETUP.bat copies this file to ".env" the first time. Edit ".env", not this.
# (Docker Compose ignores DB_MODE here: it always uses its own PostgreSQL.)
# ---------------------------------------------------------------------------

# Where the event store and the read database live:
#   embedded = real PostgreSQL 16 started automatically (no install)  <- default
#   postgres = an existing PostgreSQL server (set POSTGRES_* below)
#   sqlite   = two simple files in var/ (last-resort fallback)
DB_MODE=embedded
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# A snapshot of each account is stored every N events
SNAPSHOT_INTERVAL=5
# How often the projector checks the event log (seconds)
PROJECTOR_POLL_SECONDS=0.2

# --- AI audit assistant --------------------------------------------------
# auto = Ollama if running with the model below, else Gemini if a key is set,
#        else deterministic template (no AI). Always verified.
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Free key: https://aistudio.google.com/apikey  (leave empty to disable Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Webhook alerts --------------------------------------------------------
WEBHOOK_URLS=http://127.0.0.1:8000/webhooks/receive/
WEBHOOK_SECRET=change-me-webhook-secret
ALERT_LARGE_TRANSFER_TND=10000
ALERT_LOW_BALANCE_TND=100

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me-ds1-project14
